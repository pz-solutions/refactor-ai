{
  "name": "refactor-ai",
  "version": "0.1.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pz-solutions/refactor-ai.git"
  },
  "type": "module",
  "scripts": {
    "refactor": "node dist/cli.js",
    "build": "bun build src/cli.ts --target node --format esm --outfile dist/cli.js --external typescript && bun build scripts/demo.ts --target node --format esm --outfile dist/demo.js --external typescript && bun build scripts/npm-release.ts --target node --format esm --outfile dist/npm-release.mjs && bun build scripts/version.ts --target node --format esm --outfile dist/version.mjs && bun scripts/package-skills.ts",
    "package:skills": "bun scripts/package-skills.ts --build",
    "package:npm": "bun scripts/package-npm.ts",
    "release:npm": "node dist/npm-release.mjs",
    "test:npm": "bun test ./tests/npm-packages.integration.ts",
    "build:csharp": "dotnet build dotnet/RefactorHelper/RefactorHelper.csproj -c Release --nologo -p:RestoreLockedMode=true",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:skills": "bun run build && bun test ./tests/skills-install.integration.ts",
    "demo": "node dist/demo.js",
    "version:packages": "node dist/version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "diff": "8.0.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "@types/semver": "7.8.0",
    "semver": "7.8.5"
  }
}
